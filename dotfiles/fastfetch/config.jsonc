{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#f5b2e1",
      "2": "#f5b9a3",
      "3": "#dcbed0"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#ecdfe5"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#f5b2e1"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "#f5b2e1"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "#f5b9a3"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#dcbed0"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "#824c75"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
